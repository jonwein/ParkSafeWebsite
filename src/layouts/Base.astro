---
import '../styles/global.css';
import { APP_STORE_ID } from '../lib/app';

interface Props {
  title: string;
  description: string;
  /** Full-screen app page: no site header or footer */
  bare?: boolean;
  /** Keep the page out of search results (invite links) */
  noindex?: boolean;
  /** schema.org JSON-LD for the page */
  structuredData?: object;
}

const { title, description, bare = false, noindex = false, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og.jpg', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/map/', label: 'Map' },
  { href: '/asp/', label: 'ASP' },
  { href: '/support/', label: 'Support' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <!-- Safari on iPhone offers the app in a banner at the top -->
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    <meta property="og:site_name" content="ParkSafe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ParkSafe: every NYC parking sign on a map" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <slot name="head" />
  </head>
  <body class:list={{ bare }}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <header class="site-header">
            <div class="wrap">
              <a class="brand" href="/">
                <img src="/favicon.svg" alt="" width="28" height="28" />
                ParkSafe
              </a>
              <nav aria-label="Site">
                {nav.map(({ href, label }) => (
                  <a href={href} aria-current={path === href.replace(/\/$/, '') ? 'page' : undefined}>
                    {label}
                  </a>
                ))}
              </nav>
            </div>
          </header>

          <main class="wrap">
            <slot />
          </main>

          <footer class="site-footer">
            <div class="wrap">
              <span>© {new Date().getFullYear()} ParkSafe</span>
              <span class="footer-links">
                <a href="/privacy/">Privacy</a>
                <a href="/terms/">Terms</a>
                <a href="mailto:parksafellc@gmail.com">parksafellc@gmail.com</a>
              </span>
            </div>
          </footer>
        </>
      )
    }
  </body>
</html>
